# RepoPilot environment variables — copy to .env and fill in.
# NEVER commit .env (it is gitignored).

# Google AI Studio API key (free tier) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# GitHub personal access token (read-only repo scope is enough for Week 0)
GITHUB_TOKEN=

# Langfuse observability (optional in Week 0)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
